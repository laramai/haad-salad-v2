    color: rgba(245,241,237,0.72);
    line-height: 1.7;
    max-width: 640px;
    margin-bottom: 20px;
  }

  /* ══════════════════════════════════════════════════════════
     OPPORTUNITY
  ══════════════════════════════════════════════════════════ */
  .opp-section {
    background: var(--color-dark);
    padding: 80px 0;
  }
  .opp-inner {
    max-width: var(--max-w-site);
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: stretch;
    margin-bottom: 56px;
  }
  .opp-text .section-label { color: var(--color-accent-light); }
  .opp-text .section-title { color: #f5f1ed; }
  .opp-text .body-copy { color: rgba(245,241,237,0.62); max-width: 100%; }
  .opp-badge {
    margin-top: 24px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: var(--color-accent);
    border-top: 1px solid rgba(255,255,255,0.1);
    padding-top: 20px;
  }
  .opp-photo {
    position: relative;
    width: 100%;
    height: clamp(280px, 48vw, 520px);
    border-radius: 10px;
    overflow: hidden;
  }
  .opp-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }
  .opp-photo:hover img { transform: scale(1.03); }
  .opp-specs {
    max-width: var(--max-w-site);
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  .opp-spec {
    padding: 28px 0;
    border-right: 1px solid rgba(255,255,255,0.08);
    padding-right: 24px;
    padding-left: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .opp-spec:first-child { padding-left: 0; }
  .opp-spec:last-child { border-right: none; padding-right: 0; }
  .opp-spec-val {
    font-family: var(--font-serif);
    font-size: 28px;
    color: #fff;
    font-weight: 400;
  }
  .opp-spec-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.38);
