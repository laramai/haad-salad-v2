    letter-spacing: 0.5px;
    font-style: normal;
  }

  /* ══════════════════════════════════════════════════════════
     TERRAIN STUDY
  ══════════════════════════════════════════════════════════ */
  .terrain-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 48px;
  }
  .terrain-intro-text-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .terrain-intro-text-col .section-title-light {
    margin-bottom: 0;
  }
  .terrain-intro-body .body-copy-light { max-width: 100%; }
  .terrain-strip-caption {
    font-size: 12px;
    color: rgba(245,241,237,0.38);
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }
  .terrain-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .terrain-img-wrap {
    position: relative;
    border-radius: 6px;
