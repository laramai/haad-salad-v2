---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import L from '../components/L.astro';

const A = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/rayong-land`;
const MAPS = 'https://maps.app.goo.gl/7cxFTshbLBBN8Shi8';
const WA = 'https://wa.me/66849782915?text=Hi%2C%20I%27m%20interested%20in%20the%20110%20rai%20Rayong%20land.';
const LINE = 'https://line.me/ti/p/~laramai29';
const EMAIL = 'lara.siamland@gmail.com';

const navLinks = [
  { label: 'Opportunity', href: '#opportunity' },
  { label: 'Location',    href: '#location'    },
  { label: 'Routes',      href: '#routes'      },
  { label: 'Title Deeds', href: '#deeds'       },
  { label: 'Gallery',     href: '#gallery'     },
  { label: 'Pricing',     href: '#pricing'     },
  { label: 'Contact',     href: '#contact'     },
];
---

<Layout
  title="110 Rai Development Land, Huai Pong, Rayong | EEC | Siamland"
  description="110 rai of flat freehold (Chanote) land in Huai Pong, Rayong, inside the Eastern Economic Corridor. THB 2.7M per rai. Corner plot with concrete road on two sides, power alongside, near Highway 36 and Map Ta Phut."
>
  <Nav navLinks={navLinks} />
  <button class="lang-btn" id="langBtn" type="button" aria-label="Switch language"><span class="en">ไทย</span><span class="th">EN</span></button>

  <!-- HERO -->
  <header class="hero" id="top" style={`background-image:url('${A}/site-boundary.jpg');background-position:center;`}>
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <p class="hero-tag"><L en="Huai Pong · Rayong · Eastern Economic Corridor · Land Opportunity" th="ห้วยโปง · ระยอง · เขตพัฒนาพิเศษภาคตะวันออก (EEC) · โอกาสลงทุนที่ดิน" /></p>
      <h1 class="hero-h1"><L en="110 Rai of Freehold Land<br>in the EEC" th="ที่ดินโฉนด 110 ไร่<br>ในเขต EEC" /></h1>
      <p class="hero-lead"><L en="One flat, contiguous 110-rai holding on Soi Malawan, Huai Pong. Two Chanote titles. Corner plot with concrete public road on two sides. Power alongside. Zoning officially confirmed." th="ที่ดินผืนเดียวติดกัน 110 ไร่ ราบ ซอยมาลาวัลย์ ห้วยโปง โฉนด 2 ฉบับ ที่ดินหัวมุมติดถนนคอนกรีตสาธารณะ 2 ด้าน มีไฟฟ้าอยู่ข้างที่ดิน ผังเมืองได้รับการยืนยันแล้ว" /></p>
      <div class="hero-actions">
        <a class="btn-primary" href="#contact"><L en="Request Documents" th="ขอเอกสาร" /></a>
        <a class="btn-ghost-hero" href="#opportunity"><L en="View the Opportunity" th="ดูรายละเอียด" /></a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="hero-stat"><span class="hero-stat-val">110 <L en="Rai" th="ไร่" /></span><span class="hero-stat-label"><L en="Total Land Area" th="เนื้อที่รวม" /></span></div>
      <div class="hero-stat"><span class="hero-stat-val">2</span><span class="hero-stat-label"><L en="Chanote Titles" th="โฉนดที่ดิน" /></span></div>
      <div class="hero-stat"><span class="hero-stat-val">2.7M฿</span><span class="hero-stat-label"><L en="Price per Rai (whole plot)" th="ราคาต่อไร่ (ทั้งแปลง)" /></span></div>
      <div class="hero-stat"><span class="hero-stat-val">297.5M฿</span><span class="hero-stat-label"><L en="Total Price (whole plot)" th="ราคารวม (ทั้งแปลง)" /></span></div>
    </div>
  </header>

  <!-- OPPORTUNITY -->
  <section class="opp-section" id="opportunity">
    <div class="opp-inner">
      <div class="opp-text">
        <p class="section-label"><L en="The Opportunity" th="โอกาสการลงทุน" /></p>
        <h2 class="section-title"><L en="A Rare Single Holding.<br>Flat. Freehold. EEC." th="ที่ดินผืนใหญ่หายาก<br>ราบ โฉนดเต็ม เขต EEC" /></h2>
        <p class="body-copy"><L en="A rare, single contiguous 110-rai holding in Huai Pong, Rayong. It is hard to put together a plot of this size in the area. Both deeds are full Chanote (freehold) titles, and the zoning status has been officially confirmed, so the land is ready for buyer due diligence." th="ที่ดินแปลงใหญ่ผืนเดียวติดต่อกัน 110 ไร่ ในตำบลห้วยโปง จังหวัดระยอง หาได้ยากในพื้นที่นี้ โฉนดทั้งสองฉบับเป็นกรรมสิทธิ์เต็มรูปแบบ และสถานะผังเมืองได้รับการตรวจสอบยืนยันแล้ว พร้อมให้ผู้ซื้อตรวจสอบ" /></p>
        <p class="body-copy" style="margin-top:16px;"><L en="The land is flat, a corner plot with public concrete road frontage on two sides (about 350 m at the front and 240 m on the side) and power alongside, which helps cut development costs. It sits in one of Thailand's fastest-growing industrial and residential corridors, with a large and growing workforce nearby. It can be bought as the full 110 rai, or the two titles may be considered separately." th="พื้นที่ราบ เป็นที่ดินหัวมุมติดถนนคอนกรีตสาธารณะ 2 ด้าน (ด้านหน้าประมาณ 350 เมตร ด้านข้างประมาณ 240 เมตร) และมีไฟฟ้าอยู่ข้างที่ดิน ช่วยลดต้นทุนการพัฒนา อยู่ในแนวพัฒนาด้านอุตสาหกรรมและที่อยู่อาศัยที่เติบโตเร็วแห่งหนึ่งของประเทศ มีแรงงานจำนวนมากอาศัยอยู่ใกล้เคียง ขายทั้งแปลง 110 ไร่ หรือพิจารณาแยกขายตามโฉนดได้" /></p>
        <div class="opp-badge">✦ <L en="Chanote Title · Two Deeds · Cheaper When Bought Together" th="โฉนดที่ดิน · 2 ฉบับ · ซื้อรวมราคาถูกกว่า" /></div>
      </div>
      <div class="opp-photo">
        <img src={`${A}/eec-location.jpg`} loading="lazy" alt="Flat open land in Huai Pong, Rayong, inside the EEC" />
      </div>
    </div>
    <div class="opp-specs">
      <div class="opp-spec"><span class="opp-spec-val">110-0-67.1</span><span class="opp-spec-label"><L en="Rai (176,268 sq.m)" th="ไร่ (176,268 ตร.ม.)" /></span></div>
      <div class="opp-spec"><span class="opp-spec-val">ชน.</span><span class="opp-spec-label"><L en="Rural Community Zone" th="พื้นที่ชุมชนชนบท" /></span></div>
      <div class="opp-spec"><span class="opp-spec-val"><L en="Flat" th="ราบ" /></span><span class="opp-spec-label"><L en="Development-Ready Terrain" th="พร้อมพัฒนา" /></span></div>
      <div class="opp-spec"><span class="opp-spec-val">EEC</span><span class="opp-spec-label"><L en="Land Use Plan" th="ผังเมืองรวม" /></span></div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="section" id="location">
    <div class="location-text">
      <p class="section-label"><L en="Location" th="ที่ตั้ง" /></p>
      <h2 class="section-title"><L en="Huai Pong, Mueang Rayong<br>Eastern Seaboard" th="ตำบลห้วยโปง อำเภอเมืองระยอง<br>ชายฝั่งทะเลตะวันออก" /></h2>
      <p class="body-copy"><L en="Soi Malawan, Tambon Huai Pong, Amphoe Mueang Rayong, Rayong Province. Close to Highway 36 (Rayong–Pattaya), the main artery connecting the Eastern Seaboard, with convenient access to Map Ta Phut Industrial Estate, U-Tapao International Airport and the EEC development area." th="ซอยมาลาวัลย์ ตำบลห้วยโปง อำเภอเมืองระยอง จังหวัดระยอง ใกล้ทางหลวงหมายเลข 36 (ระยอง–พัทยา) เส้นทางหลักที่เชื่อมชายฝั่งทะเลตะวันออก เดินทางสะดวกไปยังนิคมอุตสาหกรรมมาบตาพุด ท่าอากาศยานนานาชาติอู่ตะเภา และพื้นที่โครงการ EEC" /></p>
      <div class="travel-grid">
        <div class="travel-item"><span class="travel-val">20-25 <L en="min" th="นาที" /></span><span class="travel-label"><L en="Drive to Rayong city centre" th="ถึงตัวเมืองระยอง" /></span></div>
        <div class="travel-item"><span class="travel-val">40-50 <L en="min" th="นาที" /></span><span class="travel-label"><L en="Drive to Pattaya" th="ถึงพัทยา" /></span></div>
        <div class="travel-item"><span class="travel-val"><L en="Nearby" th="ใกล้" /></span><span class="travel-label"><L en="Highway 36" th="ทางหลวงหมายเลข 36" /></span></div>
        <div class="travel-item"><span class="travel-val"><L en="Nearby" th="ใกล้" /></span><span class="travel-label"><L en="Map Ta Phut and U-Tapao" th="มาบตาพุดและอู่ตะเภา" /></span></div>
      </div>
      <ul class="check-list">
        <li><L en="Corner plot with public concrete road frontage on two sides, electricity grid alongside" th="ที่ดินหัวมุมติดถนนคอนกรีตสาธารณะ 2 ด้าน มีแนวสายไฟฟ้าอยู่ข้างที่ดิน" /></li>
        <li><L en="Flat, open terrain that is easy to develop" th="พื้นที่ราบโล่ง พัฒนาได้ง่าย" /></li>
        <li><L en="Inside the EEC, with a large and growing workforce nearby" th="อยู่ในเขต EEC มีแรงงานจำนวนมากอาศัยอยู่ใกล้เคียง" /></li>
        <li><a href={MAPS} target="_blank" rel="noopener noreferrer" style="color:var(--color-accent-hover);"><L en="View exact site on Google Maps" th="ดูตำแหน่งที่ดินบน Google Maps" /></a></li>
      </ul>
    </div>
    <div class="location-photo-full">
      <img src={`${A}/plot1-aerial.jpg`} loading="lazy" alt="Aerial view of Plot 1 (Chanote 41873)" />
    </div>
    <div class="sunset-fullbleed">
      <img src={`${A}/plot2-aerial.jpg`} loading="lazy" alt="Aerial view of Plot 2 (Chanote 41874)" class="sunset-fullbleed-img" />
    </div>
  </section>

  <!-- LOCATION & ACCESS -->
  <section class="dark-section" id="access">
    <div class="section-inner">
      <div class="access-grid">
        <div class="access-text">
          <p class="section-label-light"><L en="Location &amp; Access" th="การเข้าถึง" /></p>
          <h2 class="section-title-light"><L en="Corner Plot.<br>Public Road on Two Sides." th="ที่ดินหัวมุม<br>ติดถนนสาธารณะ 2 ด้าน" /></h2>
          <p class="body-copy-light"><L en="This is a corner plot with public concrete road frontage on two sides, about 350 m at the front and 240 m on the side. The electricity grid runs alongside the property. Flat terrain with road and power already in place reduces the cost and time of getting a project started." th="ที่ดินหัวมุมติดถนนคอนกรีตสาธารณะ 2 ด้าน (ด้านหน้าประมาณ 350 เมตร ด้านข้างประมาณ 240 เมตร) และมีแนวสายไฟฟ้าผ่านขนานกับที่ดิน พื้นที่ราบที่มีถนนและไฟฟ้าพร้อม ช่วยลดต้นทุนและเวลาในการเริ่มโครงการ" /></p>
          <ul class="check-list-light">
            <li><L en="Public concrete road on two sides (about 350 m front, 240 m side)" th="ติดถนนคอนกรีตสาธารณะ 2 ด้าน (ด้านหน้าประมาณ 350 ม. ด้านข้างประมาณ 240 ม.)" /></li>
            <li><L en="Electricity grid alongside the property" th="มีแนวสายไฟฟ้าขนานกับที่ดิน" /></li>
            <li><L en="Flat, development-ready terrain" th="พื้นที่ราบ พร้อมพัฒนา" /></li>
            <li><L en="20-25 minutes to Rayong city centre" th="20-25 นาทีถึงตัวเมืองระยอง" /></li>
          </ul>
        </div>
        <div class="access-photo">
          <img src={`${A}/road-frontage.jpg`} loading="lazy" alt="Plot fronting a public concrete road" />
          <div class="photo-badge"><L en="Corner Plot · Road on Two Sides" th="ที่ดินหัวมุม · ติดถนน 2 ด้าน" /></div>
        </div>
      </div>
      <div class="access-callout">
        <p class="callout-eyebrow-light"><L en="Parcel Map - Plots 1 and 2" th="แผนที่แปลงที่ดิน - แปลง 1 และแปลง 2" /></p>
        <p class="body-copy-light"><L en="The two chanote titles in Huai Pong, shown on the map. " th="โฉนดทั้งสองฉบับในตำบลห้วยโปง ตามแผนที่" /> <a href={MAPS} target="_blank" rel="noopener noreferrer" style="color:var(--color-accent-light);"><L en="Open in Google Maps" th="เปิดใน Google Maps" /></a></p>
        <div class="tag-row">
          <span class="tag-dark"><L en="Road on 2 Sides" th="ติดถนน 2 ด้าน" /></span>
          <span class="tag-dark"><L en="Power Alongside" th="ไฟฟ้าข้างที่ดิน" /></span>
          <span class="tag-dark"><L en="Flat Land" th="พื้นที่ราบ" /></span>
          <span class="tag-dark"><L en="2 Chanote" th="โฉนด 2 ฉบับ" /></span>
        </div>
        <img class="map-img" src={`${A}/parcel-map.jpg`} loading="lazy" alt="Parcel map showing plots 1 and 2 in Huai Pong" />
      </div>
    </div>
  </section>

  <!-- DEVELOPMENT POTENTIAL -->
  <section class="section" id="potential">
    <div class="seaview-grid">
      <div class="seaview-text">
        <p class="section-label"><L en="Development Potential" th="ศักยภาพการพัฒนา" /></p>
        <h2 class="section-title"><L en="Housing, Logistics<br>or Land Banking" th="ที่อยู่อาศัย โลจิสติกส์<br>หรือซื้อเก็บเพื่อลงทุน" /></h2>
        <p class="body-copy"><L en="Residential: housing estates and worker accommodation serving the surrounding industrial workforce. This is the strongest fit for the zoning." th="ที่อยู่อาศัย: หมู่บ้านจัดสรรและที่พักสำหรับแรงงานในนิคมอุตสาหกรรมโดยรอบ เป็นการใช้งานที่เหมาะกับผังเมืองมากที่สุด" /></p>
        <p class="body-copy" style="margin-top:16px;"><L en="Warehouse and logistics: storage and distribution facilities serving Map Ta Phut and the wider EEC logistics network, subject to standard setback requirements. Selected factory types: certain factory types not restricted by the zoning rules, subject to approval. Land banking: a large, single contiguous holding in a corridor with a strong long-term growth outlook." th="คลังสินค้าและโลจิสติกส์: คลังสินค้าและศูนย์กระจายสินค้าที่รองรับมาบตาพุดและเครือข่ายโลจิสติกส์ EEC ทั้งนี้ต้องเป็นไปตามเงื่อนไขระยะร่นตามกฎหมาย โรงงานบางประเภท: โรงงานบางประเภทที่ผังเมืองไม่ห้าม ทั้งนี้ต้องได้รับอนุญาต ซื้อเก็บเพื่อลงทุน: ที่ดินแปลงใหญ่ผืนเดียวติดต่อกัน ในทำเลที่มีแนวโน้มเติบโตระยะยาว" /></p>
        <blockquote class="study-quote">
          <p><L en="Zoning permits residential, agricultural, and public-use development. Warehouse and factory use depends on the type of operation and requires approval. Buyers should confirm intended use with the Rayong Provincial Public Works and Town Planning Office." th="ผังเมืองอนุญาตที่อยู่อาศัย เกษตรกรรม และกิจการสาธารณะ คลังสินค้าและโรงงานขึ้นอยู่กับประเภทกิจการและการอนุญาต โปรดตรวจสอบกับสำนักงานโยธาธิการและผังเมืองจังหวัดระยอง" /></p>
          <cite>- <L en="Land use zoning: Rural Community Zone (Chor Nor), EEC Land Use Plan" th="การใช้ประโยชน์ที่ดิน: พื้นที่ชุมชนชนบท (ชน.) ผังเมืองรวม EEC" /></cite>
        </blockquote>
      </div>
      <div class="seaview-photo">
        <img src={`${A}/concept-residential.jpg`} loading="lazy" alt="Residential concept: housing estate with clubhouse and pool" />
        <p class="photo-caption-below"><L en="Residential concept. Housing estate with clubhouse and pool. Artistic visualisation only." th="แนวคิดโครงการที่อยู่อาศัย หมู่บ้านจัดสรรพร้อมสโมสรและสระว่ายน้ำ (ภาพจำลอง)" /></p>
      </div>
    </div>
    <div class="callout-card">
      <div class="callout-card-text">
        <p class="callout-eyebrow"><L en="Warehouse and Logistics Concept" th="แนวคิดคลังสินค้าและโลจิสติกส์" /></p>
        <p class="body-copy"><L en="Distribution centre with truck yard, positioned to serve Map Ta Phut and the wider EEC logistics network. These images are artistic visualisations to help buyers imagine possible uses. They are not approved plans or guarantees. Any development must comply with the Rural Community zoning rules and receive the required approvals." th="ศูนย์กระจายสินค้าพร้อมลานจอดรถบรรทุก รองรับมาบตาพุดและเครือข่ายโลจิสติกส์ EEC ภาพเหล่านี้เป็นภาพจำลองเพื่อให้ผู้ซื้อเห็นแนวทางการใช้ประโยชน์ที่เป็นไปได้ ไม่ใช่แบบที่ได้รับอนุมัติหรือการรับรองใด ๆ การพัฒนาต้องเป็นไปตามข้อกำหนดผังเมืองพื้นที่ชุมชนชนบท และได้รับอนุญาตตามที่กฎหมายกำหนด" /></p>
        <div class="tag-row">
          <span class="tag"><L en="Residential" th="ที่อยู่อาศัย" /></span>
          <span class="tag"><L en="Warehouse &amp; Logistics" th="คลังสินค้าและโลจิสติกส์" /></span>
          <span class="tag"><L en="Selected Factories (with approval)" th="โรงงานบางประเภท (ต้องได้รับอนุญาต)" /></span>
          <span class="tag"><L en="Land Banking" th="ซื้อเก็บ" /></span>
          <span class="tag"><L en="Data Centre (subject to approval)" th="Data Center (ขึ้นอยู่กับการอนุญาต)" /></span>
        </div>
      </div>
      <div class="callout-card-photo">
        <img src={`${A}/concept-warehouse.jpg`} loading="lazy" alt="Warehouse and logistics concept: distribution centre with truck yard" />
      </div>
    </div>
  </section>

  <!-- KEY ROUTES -->
  <section class="dark-section" id="routes">
    <div class="section-inner">
      <p class="section-label-light"><L en="Key Routes" th="เส้นทางสำคัญ" /></p>
      <div class="terrain-intro">
        <div class="terrain-intro-text-col">
          <h2 class="section-title-light"><L en="Airport, Industrial Estate and Highway" th="สนามบิน นิคมอุตสาหกรรม และทางหลวง" /></h2>
          <a class="btn-primary terrain-intro-download" href="#contact"><L en="Request documents" th="ขอเอกสาร" /></a>
        </div>
        <div class="terrain-intro-body">
          <p class="body-copy-light"><L en="Three routes show how the land connects to the main EEC hubs. Routes are indicative and for illustration. Actual travel times depend on traffic." th="สามเส้นทางนี้แสดงการเชื่อมต่อจากที่ดินไปยังศูนย์กลางหลักของ EEC เส้นทางเป็นเพียงแนวทางโดยประมาณ เวลาเดินทางจริงขึ้นอยู่กับสภาพการจราจร" /></p>
          <ul class="check-list-light">
            <li><L en="U-Tapao International Airport" th="ท่าอากาศยานนานาชาติอู่ตะเภา" /></li>
            <li><L en="Map Ta Phut Industrial Estate" th="นิคมอุตสาหกรรมมาบตาพุด" /></li>
            <li><L en="Highway 36 (Rayong–Pattaya)" th="ทางหลวงหมายเลข 36 (ระยอง–พัทยา)" /></li>
            <li><L en="20-25 min to Rayong city centre, 40-50 min to Pattaya" th="20-25 นาทีถึงตัวเมืองระยอง 40-50 นาทีถึงพัทยา" /></li>
          </ul>
        </div>
      </div>
      <div class="terrain-strip">
