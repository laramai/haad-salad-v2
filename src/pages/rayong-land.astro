  }
  .check-list-light li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }
  .callout-eyebrow {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 400;
    color: var(--color-ink);
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .callout-eyebrow-light {
    font-family: var(--font-serif);
    font-size: clamp(16px, 2vw, 22px);
    font-weight: 400;
    color: #f5f1ed;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  .tag-row {
