    display: block;
    transition: transform 0.7s ease;
  }
  .callout-card-photo:hover img { transform: scale(1.04); }
  .callout-card-text .callout-eyebrow { color: #f5f1ed; }
  .callout-card-text .body-copy { color: rgba(245,241,237,0.65); max-width: 100%; }

  /* ══════════════════════════════════════════════════════════
     SUNSET FULL-BLEED
  ══════════════════════════════════════════════════════════ */
  .sunset-fullbleed {
