  }
  .section-title-light {
    font-family: var(--font-serif);
    font-size: clamp(28px, 4vw, 46px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.5px;
    color: #f5f1ed;
    margin-bottom: 20px;
    max-width: 680px;
  }
  .body-copy-light {
    font-size: 16px;
    color: rgba(245,241,237,0.62);
