    color: #fff;
    font-weight: 400;
  }
  .hero-stat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.45);
  }

  /* ══════════════════════════════════════════════════════════
     SHARED SECTION ATOMS
  ══════════════════════════════════════════════════════════ */
  .section {
    max-width: var(--max-w-site);
    margin: 0 auto;
    padding: 80px 32px;
    width: 100%;
    box-sizing: border-box;
  }
  .section-label {
