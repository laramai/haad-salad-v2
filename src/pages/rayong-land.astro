  .btn-ghost:hover { background: var(--color-accent); color: #fff; border-color: var(--color-accent); transform: translateY(-1px); }
  .btn-full { width: 100%; text-align: center; margin-top: 24px; }

  /* Hero stats bar */
  .hero-stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid rgba(255,255,255,0.15);
