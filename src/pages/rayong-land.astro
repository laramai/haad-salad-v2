  .terrain-img-wrap img {
    width: 100%;
    height: clamp(240px, 28vw, 380px);
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .terrain-img-wrap:hover img { transform: scale(1.04); }
  .terrain-img-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: rgba(245,241,237,0.45);
    margin-top: 10px;
    line-height: 1.4;
  }

  /* ══════════════════════════════════════════════════════════
     TOPOGRAPHY
  ══════════════════════════════════════════════════════════ */
  .topo-intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 40px;
  }
  .topo-lead { max-width: 100%; }
  .topo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 48px;
  }
  .topo-card {
    background: var(--color-card);
    padding: 32px 28px;
    transition: background 0.2s ease;
  }
  .topo-card:hover { background: #faf7f3; }
  .topo-card-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    color: #f5f1ed;
    margin-bottom: 12px;
  }
  .topo-card-body {
    font-size: 15px;
    color: rgba(245,241,237,0.65);
    line-height: 1.7;
  }
  .topo-card:hover .topo-card-title { color: var(--color-ink); }
  .topo-card:hover .topo-card-body { color: var(--color-muted); }
