    width: 100%;
    border-radius: 10px;
    overflow: hidden;
  }
  .topo-flat-img img {
    width: 100%;
    height: clamp(300px, 42vw, 560px);
    object-fit: cover;
    object-position: center 40%;
    display: block;
    border-radius: 10px;
  }
  .topo-callout {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: clamp(280px, 36vw, 480px);
  }
  .topo-callout-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }
  .topo-callout:hover .topo-callout-img { transform: scale(1.02); }
  .topo-callout-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,8,5,0.96) 0%, rgba(10,8,5,0.68) 45%, rgba(10,8,5,0.28) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px 40px 36px;
  }
  .topo-callout-body {
    font-size: 15px;
    color: rgba(245,241,237,0.72);
    line-height: 1.65;
    max-width: 560px;
    margin-bottom: 16px;
  }

  /* ══════════════════════════════════════════════════════════
     GALLERY (dark)
  ══════════════════════════════════════════════════════════ */
  .gallery-section {
    background: #1a1612;
    padding: 80px 0;
    overflow: hidden;
    width: 100%;
  }
  .gallery-header {
    max-width: var(--max-w-site);
    margin: 0 auto;
    padding: 0 32px 48px;
  }
  .gallery-group { margin-bottom: 52px; }
  .gallery-group:last-child { margin-bottom: 0; }
  .gallery-group-label {
    max-width: var(--max-w-site);
    margin: 0 auto 16px;
    padding: 0 32px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: rgba(247,244,239,0.38);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }


  .gallery-strip {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 32px 8px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(196,151,95,0.3) transparent;
  }
  .gallery-strip::-webkit-scrollbar { height: 4px; }
