  }
  .access-callout {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding-top: 40px;
  }

  /* ══════════════════════════════════════════════════════════
     SEA VIEW
  ══════════════════════════════════════════════════════════ */
  .seaview-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: stretch;
    margin-bottom: 56px;
  }
  .seaview-photo {
    position: relative;
    width: 100%;
  }
  .seaview-photo img {
    width: 100%;
    height: clamp(280px, 48vw, 520px);
    object-fit: cover;
    border-radius: 10px;
    display: block;
    transition: transform 0.7s ease;
