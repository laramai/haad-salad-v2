  /* ══════════════════════════════════════════════════════════
     FULL-WIDTH YOUTUBE (autoplay muted; mobile can tap / use controls)
  ══════════════════════════════════════════════════════════ */
  .video-embed-section {
    width: 100%;
    background: #0a0806;
  }
  .video-embed-wrap {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
  }
  .video-embed-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Desktop: transparent layer blocks taps; mobile taps hit the iframe (controls=1 in URL). */
  @media (min-width: 901px) {
    .video-embed-wrap::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }
  }

  /* ══════════════════════════════════════════════════════════
     LOCATION
  ══════════════════════════════════════════════════════════ */
  .location-text {
    max-width: 720px;
    margin-bottom: 48px;
  }
  .location-photo-full {
    position: relative;
    width: 100%;
    height: clamp(360px, 52vw, 640px);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 56px;
  }
  .location-photo-full img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    display: block;
    transition: transform 0.8s ease;
  }
  .location-photo-full:hover img { transform: scale(1.02); }
  .travel-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    overflow: hidden;
    margin-top: 32px;
    margin-bottom: 24px;
  }
  .travel-item {
    background: #faf7f3;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .travel-val {
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--color-ink);
    font-weight: 400;
  }
  .travel-label {
    font-size: 12px;
    color: var(--color-muted);
    font-weight: 600;
    line-height: 1.3;
  }

  /* ══════════════════════════════════════════════════════════
     ACCESS (dark section)
  ══════════════════════════════════════════════════════════ */
  .access-grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
    align-items: stretch;
    margin-bottom: 56px;
  }
  .access-photo {
    position: relative;
    width: 100%;
    height: clamp(280px, 48vw, 520px);
    border-radius: 10px;
    overflow: hidden;
  }
  .access-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s ease;
  }
  .access-photo:hover img { transform: scale(1.03); }
  .photo-badge {
    position: absolute;
    bottom: 16px;
    left: 16px;
    background: rgba(20,15,10,0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 5px;
    padding: 7px 12px;
