  }
  .btn-ghost-hero:hover { background: rgba(255,255,255,0.12); border-color: rgba(255,255,255,0.6); transform: translateY(-1px); }
  .btn-ghost {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.3px;
    background: transparent;
    color: var(--color-accent);
    border: 1px solid var(--color-line);
    border-radius: 7px;
    padding: 13px 22px;
    cursor: pointer;
    text-decoration: none;
