---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';

const navLinks = [
  { label: 'Opportunity', href: '#opportunity' },
  { label: 'Location',    href: '#location'    },
  { label: 'Terrain',     href: '#terrain'     },
  { label: 'Gallery',     href: '#gallery'     },
  { label: 'Pricing',     href: '#pricing'     },
  { label: 'Contact',     href: '#contact'     },
];
---

<Layout
  title="Haad Salad Land - Where Hillside Meets the Sea | Koh Phangan"
  description="A rare 2-rai hillside site in Haad Salad, terrain-confirmed for 7 cascading boutique villas with unobstructed sunset sea views. Chanote title. Concrete public road. Ready to develop."
>
  <Nav navLinks={navLinks} ctaHref="/request-documents" ctaLabel="Request Documents" />

  <!-- ═══════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════ -->
  <header class="hero" id="top">
    <div class="hero-overlay"></div>
    <div class="hero-inner">
      <p class="hero-tag">Haad Salad · Koh Phangan · West Coast · Developer Opportunity</p>
      <h1 class="hero-h1">Where Hillside<br>Meets the Sea</h1>
      <p class="hero-lead">A rare 2-rai hillside site in Haad Salad - terrain-confirmed for 7 cascading boutique villas with unobstructed sunset sea views. Chanote title. Concrete public road. Ready to develop.</p>
      <div class="hero-actions">
        <a class="btn-primary" href="/request-documents">Request Chanote &amp; Full Report</a>
        <a class="btn-ghost-hero" href="#opportunity">View the Opportunity</a>
      </div>
    </div>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-val">2 Rai</span>
        <span class="hero-stat-label">Total Land Area</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-val">6-8</span>
        <span class="hero-stat-label">Villa Capacity</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-val">15°</span>
        <span class="hero-stat-label">Consistent Slope</span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-val">28M฿</span>
        <span class="hero-stat-label">Together Price</span>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════════════
       OPPORTUNITY
  ═══════════════════════════════════════════════════════ -->
  <section class="opp-section" id="opportunity">
    <div class="opp-inner">
      <div class="opp-text">
        <p class="section-label">The Opportunity</p>
        <h2 class="section-title">Clean Title. Concrete Road.<br>Confirmed Seaviews.</h2>
        <p class="body-copy">The site has been comprehensively studied - terrain modelling, slope analysis, viewshed assessment at 6m and 12m building heights, and 6-8 villa placement feasibility positioning - all confirmed. The land carries chanote title and is already subdivided into two plots, giving buyers maximum flexibility.</p>
        <p class="body-copy" style="margin-top:16px;">The topography does the heavy lifting. A rare consistent 15-degree slope across the full 2-rai site means minimal earthwork, natural drainage, staggered sightlines, and no villa blocking another's view. Add direct public concrete road access with minimal road construction cost and you have the rarest combination on Koh Phangan.</p>
        <div class="opp-badge">✦ Chanote Title · Clean &amp; Ready to Transfer · Two Subdivided Plots</div>
      </div>
      <div class="opp-photo">
        <img src="/assets/bay-aerial-wide.png" loading="lazy" alt="Wide aerial view of Haad Salad headland and surrounding bay" />
      </div>
    </div>
    <div class="opp-specs">
      <div class="opp-spec">
        <span class="opp-spec-val">6-8</span>
        <span class="opp-spec-label">Villa Placements with Privacy</span>
      </div>
      <div class="opp-spec">
        <span class="opp-spec-val">2-3BR</span>
        <span class="opp-spec-label">Per Villa</span>
      </div>
      <div class="opp-spec">
        <span class="opp-spec-val">300m²</span>
        <span class="opp-spec-label">Max Footprint</span>
      </div>
      <div class="opp-spec">
        <span class="opp-spec-val">12m</span>
        <span class="opp-spec-label">Max Height</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       LOCATION
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="location">
    <div class="location-grid">
      <div class="location-text">
        <p class="section-label">Location</p>
        <h2 class="section-title">Haad Salad, West Coast<br>Koh Phangan</h2>
        <p class="body-copy">Positioned on the upper hillside above Haad Salad bay - one of Koh Phangan's most coveted west-coast addresses. Close enough to the beach to walk, high enough to command the view.</p>
        <div class="travel-grid">
          <div class="travel-item">
            <span class="travel-val">2 min</span>
            <span class="travel-label">Drive to Haad Salad Beach</span>
          </div>
          <div class="travel-item">
            <span class="travel-val">6 min</span>
            <span class="travel-label">Drive to Srithanu</span>
          </div>
          <div class="travel-item">
            <span class="travel-val">17 min</span>
            <span class="travel-label">Drive to Thong Sala Ferry Pier</span>
          </div>
          <div class="travel-item">
            <span class="travel-val">10 min</span>
            <span class="travel-label">Drive to Zen Beach</span>
          </div>
        </div>
        <ul class="check-list">
          <li>Connected to public concrete road and electricity infrastructure</li>
          <li>Build up to 12m height across the full site (starting from 10m down from the road)</li>
          <li>Quiet, green hillside enclave - established villas nearby, not overcrowded</li>
          <li>West-facing - direct sunset exposure year-round from all villa positions</li>
          <li>Coordinates: 9.781429, 99.973356</li>
        </ul>
      </div>
      <div class="location-photo">
        <img src="/assets/bay-breakwater.png" loading="lazy" alt="Haad Salad bay with breakwater and Gulf of Thailand" />
      </div>
    </div>

    <div class="callout-card">
      <div class="callout-card-text">
        <p class="callout-eyebrow">West-Facing Golden Hour - Every Evening, Every Villa</p>
        <p class="body-copy">The site faces west toward the Gulf of Thailand, delivering year-round uninterrupted sunset views across 6-8 villa placements. A permanent, structurally unblockable asset - and the single most powerful driver of premium nightly rates on Koh Phangan's west coast.</p>
        <div class="tag-row">
          <span class="tag">West-Facing Exposure</span>
          <span class="tag">Year-Round Sunsets</span>
          <span class="tag">Unblockable Sightlines</span>
          <span class="tag">Premium ADR Driver</span>
        </div>
      </div>
      <div class="callout-card-photo">
        <img src="/assets/sunset-palms-villas.png" loading="lazy" alt="Golden hour sunset framed by tropical palms overlooking the bay" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       LOCATION & ACCESS
  ═══════════════════════════════════════════════════════ -->
  <section class="dark-section" id="access">
    <div class="section-inner">
      <div class="access-grid">
        <div class="access-text">
          <p class="section-label-light">Location &amp; Access</p>
          <h2 class="section-title-light">Public Road Frontage.<br>Minimal Road Construction Cost.</h2>
          <p class="body-copy-light">The land sits directly on a public concrete road running the full width of the top boundary - a decisive advantage rarely available on hillside Koh Phangan sites. Road construction is one of the largest hidden costs in island development. Here, it is minimal.</p>
          <p class="body-copy-light" style="margin-top:16px;">The road provides 24/7 visibility and efficient top-boundary access. This setup materially reduces total road scope and complexity while still creating permanent organic roadside marketing - every passing vehicle sees the development throughout the construction and sales phase.</p>
          <p class="body-copy-light" style="margin-top:16px;">Haad Salad is one of Koh Phangan's most established west-coast enclaves - quieter and more refined than Srithanu, with a growing reputation for boutique resort development. The west coast's track record includes projects like Bay Villas, which demonstrated sustained demand and strong investor returns in comparable hillside positions.</p>
          <ul class="check-list-light">
            <li>Public concrete road - full width at top of plot</li>
            <li>Minimal road construction cost</li>
            <li>24/7 roadside visibility - organic passive marketing</li>
            <li>Comparable to Bay Villas - proven demand corridor</li>
          </ul>
        </div>
        <div class="access-photo">
          <img src="/assets/road-access.png" loading="lazy" alt="Concrete public road providing direct access to the plot" />
          <div class="photo-badge">Paved Road Access · Top of Plot</div>
        </div>
      </div>

      <div class="access-callout">
        <p class="callout-eyebrow-light">Direct Public Road Access - Top of Plot</p>
        <p class="body-copy-light">Concrete public road runs the full width of the land boundary. No easements to negotiate for the main approach, minimal road budget required, no construction timeline delays waiting for access.</p>
        <div class="tag-row">
          <span class="tag-dark">Public Road</span>
          <span class="tag-dark">Minimal Road Cost</span>
          <span class="tag-dark">Immediate Access</span>
          <span class="tag-dark">24/7 Roadside Visibility</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SEA VIEW ANALYSIS
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="seaview">
    <div class="seaview-grid">
      <div class="seaview-text">
        <p class="section-label">Sea View Analysis</p>
        <h2 class="section-title">Unobstructed Views Confirmed<br>at 6m and 12m Height</h2>
        <p class="body-copy">A commissioned terrain, slope, and viewshed study - including drone-based terrain modelling, orthophoto mapping, and 3D massing analysis - confirms clear, unobstructed sea views at both 6m and 12m building heights across 6-8 villa placements.</p>
        <p class="body-copy" style="margin-top:16px;">Even with a neighbouring structure rising to approximately 10m, the analysis confirms the primary sea views remain unaffected across all positions. The site's elevation advantage is structural - built into the terrain, not dependent on neighbouring land staying low.</p>
        <blockquote class="study-quote">
          <p>"Sea view analysis indicates clear views from both 6m and 12m building heights across all proposed villa locations. A neighbouring building of approximately 10m is unlikely to significantly block the primary sea views."</p>
          <cite>- Independent Land Visibility Study, March 2026</cite>
        </blockquote>
      </div>
      <div class="seaview-photo">
        <img src="/assets/villa-pool-seaview.png" loading="lazy" alt="Infinity pool villa with panoramic sea view over Haad Salad bay and the Gulf of Thailand" />
        <p class="photo-caption-below">Rendered sea view at 6m building height - terrain-based massing model, verified against on-site photography</p>
      </div>
    </div>

    <div class="callout-card">
      <div class="callout-card-text">
        <p class="callout-eyebrow">Turquoise Waters of the Gulf - Haad Salad Bay</p>
        <p class="body-copy">Haad Salad bay's signature shallow reef water is visible from every elevated position on the site. This is the view that justifies premium nightly rates across comparable west-coast Koh Phangan boutique properties.</p>
        <div class="tag-row">
          <span class="tag">Haad Salad Bay</span>
          <span class="tag">Reef Water Visibility</span>
          <span class="tag">Premium Rate Justification</span>
          <span class="tag">Gulf of Thailand</span>
        </div>
      </div>
      <div class="callout-card-photo">
        <img src="/assets/bay-aerial-golden.png" loading="lazy" alt="Aerial view of Haad Salad bay at golden hour" />
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       TERRAIN STUDY - MASTERPLAN & TECHNICAL DRAWINGS
  ═══════════════════════════════════════════════════════ -->
  <section class="dark-section" id="terrain">
    <div class="section-inner">
      <p class="section-label-light">Terrain Study - Masterplan &amp; Technical Drawings</p>
      <div class="terrain-intro">
        <h2 class="section-title-light">Terrain &amp; Drone 3D Mapping</h2>
        <div class="terrain-intro-body">
          <p class="body-copy-light">The site underwent comprehensive terrain analysis including drone-based terrain modelling and orthophoto mapping, producing a precise 3D model verified against real on-site photography. The drawings below represent the outputs of that study - masterplan positioning, elevation sections, and slope profile analysis across three cross-sections of the full plot.</p>
          <ul class="check-list-light">
            <li>Masterplan - 6-8 villa placement on terrain (A.01)</li>
            <li>Elevation section - cascading villa heights on slope (A.02)</li>
            <li>3D massing model - villa form on hillside (A.03)</li>
            <li>Slope profile analysis - Sections A, B &amp; C</li>
            <li>Confirmed gradient: 15.7° to 16.4° across all sections</li>
            <li>Elevation range: 45-76m ASL across full 2-rai site</li>
          </ul>
        </div>
      </div>

      <p class="terrain-strip-caption">Slope Profile Analysis - Sections A, B &amp; C - consistent 15-16° gradient confirmed across all three cross-sections</p>
      <div class="terrain-strip">
        <div class="terrain-img-wrap">
          <img src="/assets/drawing-a01-masterplan.png" loading="lazy" alt="A.01 Masterplan - top view showing 6-8 villa placement on terrain with pools" />
          <span class="terrain-img-label">A.01 - Masterplan (Top View) - 6-8 Villa Placement</span>
        </div>
        <div class="terrain-img-wrap">
          <img src="/assets/drawing-a02-elevation.png" loading="lazy" alt="A.02 Elevation section - cascading villa heights on slope profile" />
          <span class="terrain-img-label">A.02 - Elevation Section - Villa Heights on Slope</span>
        </div>
        <div class="terrain-img-wrap">
          <img src="/assets/drawing-a03-massing.png" loading="lazy" alt="A.03 3D massing model - villas cascading down the hillside in perspective" />
          <span class="terrain-img-label">A.03 - 3D Massing Model - Cascading Villa Form</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       TOPOGRAPHY & DEVELOPMENT CONDITIONS
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="topography">
    <p class="section-label">Topography &amp; Development Conditions</p>
    <div class="topo-intro">
      <h2 class="section-title">Rare 15° Consistent Slope.<br>Built for Cascading Villas.</h2>
      <p class="body-copy topo-lead">Most hillside sites in Koh Phangan suffer from irregular terrain requiring expensive retaining walls. This site is different: a consistent 15-degree slope across the full 2-rai area - precisely what cascading villa architecture requires and extremely rare to find at this scale.</p>
    </div>

    <div class="topo-grid">
      <div class="topo-card">
        <h4 class="topo-card-title">Green Zone Hillside Category</h4>
        <p class="topo-card-body">The site falls below the 80m altitude threshold, placing it in the green zone hillside development category. This permits structures up to 12m in height with a maximum footprint of 300m² per structure - optimal parameters for 2-bedroom boutique villas.</p>
      </div>
      <div class="topo-card">
        <h4 class="topo-card-title">Consistent 15-16° Gradient</h4>
        <p class="topo-card-body">Slope profile analysis across three cross-sections (A, B, C) confirms a consistent 15.7° to 16.4° gradient across the full site. Each villa steps naturally down the hillside without blocking another's view - eliminating complex retaining engineering and significantly reducing earthwork costs.</p>
      </div>
      <div class="topo-card">
        <h4 class="topo-card-title">Natural Drainage Flow</h4>
        <p class="topo-card-body">Surface drainage flow analysis confirms water movement follows the slope naturally - meaning site drainage is gravity-fed. No engineered drainage systems required beyond standard villa-level specification, reducing infrastructure cost and construction complexity.</p>
      </div>
      <div class="topo-card">
        <h4 class="topo-card-title">Minimal Excavation Required</h4>
        <p class="topo-card-body">Building placement aligned with the natural terrain slope minimises excavation throughout. With a consistent gradient and confirmed villa positions, this site requires significantly less civil works than comparable hillside plots - a direct saving on project cost and timeline.</p>
      </div>
    </div>

    <div class="topo-callout">
      <img src="/assets/plot-trees-view.png" loading="lazy" alt="On-plot view through tall tropical trees with sea visible in background" class="topo-callout-img" />
      <div class="topo-callout-overlay">
        <p class="callout-eyebrow">Consistent 15° Hillside - Full 2 Rai</p>
        <p class="topo-callout-body">The uniform gradient eliminates the retaining wall engineering that typically consumes 15-25% of hillside development budgets on irregular terrain. Seven villa positions. Natural steps. No site fighting the architecture.</p>
        <div class="tag-row">
          <span class="tag-dark">Consistent 15° Slope</span>
          <span class="tag-dark">Below 80m Altitude</span>
          <span class="tag-dark">Green Zone Compliant</span>
          <span class="tag-dark">Minimal Earthwork</span>
          <span class="tag-dark">Natural Drainage</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       GALLERY
  ═══════════════════════════════════════════════════════ -->
  <section class="gallery-section" id="gallery">
    <div class="gallery-header">
      <p class="section-label" style="color:var(--color-accent-light);">The Land</p>
      <h2 class="section-title" style="color:#f7f4ef;max-width:500px;">See the plot firsthand</h2>
      <p class="section-lead-light">Panoramic sea views, established road access, and lush tropical surroundings on a quiet hillside above Haad Salad bay. Scroll each row to explore.</p>
    </div>

    <div class="gallery-group">
      <div class="gallery-group-label">Sunsets from the plot</div>
      <div class="gallery-strip">
        <div class="gallery-strip-item"><img src="/assets/sunset-bay-drone.png" loading="lazy" alt="Dramatic orange sunset over Haad Salad bay from drone" /><span class="strip-badge">Sunset · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/sunset-panorama-drone.png" loading="lazy" alt="Wide Gulf of Thailand sunset panorama from drone" /><span class="strip-badge">Gulf Panorama · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/sunset-headland-drone.png" loading="lazy" alt="Aerial sunset view of the Haad Salad headland" /><span class="strip-badge">Headland at Sunset · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/sunset-palm-fronds.png" loading="lazy" alt="Sun setting through palm fronds with villas below" /><span class="strip-badge">Through the Palms</span></div>
        <div class="gallery-strip-item"><img src="/assets/sunset-palms-villas.png" loading="lazy" alt="Golden hour sunset framed by tropical palms" /><span class="strip-badge">Golden Hour</span></div>
        <div class="gallery-strip-item"><img src="/assets/sunset-view.png" loading="lazy" alt="Golden-hour sunset view from the hilltop" /><span class="strip-badge">Sunset Over the Bay</span></div>
      </div>
    </div>

    <div class="gallery-group">
      <div class="gallery-group-label">Sea &amp; bay views</div>
      <div class="gallery-strip">
        <div class="gallery-strip-item"><img src="/assets/sea-view.png" loading="lazy" alt="Panoramic turquoise sea view from the plot" /><span class="strip-badge">Turquoise Sea View</span></div>
        <div class="gallery-strip-item"><img src="/assets/view-headland.png" loading="lazy" alt="Rocky tropical headland and deep blue sea through foliage" /><span class="strip-badge">Rocky Headland</span></div>
        <div class="gallery-strip-item"><img src="/assets/bay-breakwater.png" loading="lazy" alt="Haad Salad bay with breakwater at dusk" /><span class="strip-badge">Haad Salad Bay</span></div>
        <div class="gallery-strip-item"><img src="/assets/bay-breakwater-2.png" loading="lazy" alt="Wide bay view showing breakwater and village below" /><span class="strip-badge">Bay &amp; Breakwater</span></div>
        <div class="gallery-strip-item"><img src="/assets/view-sea-dusk.png" loading="lazy" alt="Open sea at dusk framed through tropical trees" /><span class="strip-badge">Sea at Dusk</span></div>
        <div class="gallery-strip-item"><img src="/assets/bay-aerial-golden.png" loading="lazy" alt="Aerial view of Haad Salad bay at golden hour" /><span class="strip-badge">Bay at Golden Hour · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/bay-aerial-wide.png" loading="lazy" alt="Wide aerial view of Haad Salad headland and bay" /><span class="strip-badge">Full Bay · Drone</span></div>
      </div>
    </div>

    <div class="gallery-group">
      <div class="gallery-group-label">The plot &amp; access</div>
      <div class="gallery-strip">
        <div class="gallery-strip-item"><img src="/assets/plot-trees-view.png" loading="lazy" alt="On-plot view through tall tropical trees with sea in background" /><span class="strip-badge">On the Land</span></div>
        <div class="gallery-strip-item"><img src="/assets/plot-trees-view-2.png" loading="lazy" alt="Tropical tree canopy on the plot with Gulf in the distance" /><span class="strip-badge">Plot Canopy</span></div>
        <div class="gallery-strip-item"><img src="/assets/road-access.png" loading="lazy" alt="Concrete private road providing direct access to the plot" /><span class="strip-badge">Paved Road Access</span></div>
        <div class="gallery-strip-item"><img src="/assets/aerial-overview.png" loading="lazy" alt="Aerial drone overview of the plot with bay visible in background" /><span class="strip-badge">Plot Overview · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/aerial-hillside.png" loading="lazy" alt="Aerial view of the plot on hillside with adjacent luxury villas" /><span class="strip-badge">Adjacent Villas · Drone</span></div>
        <div class="gallery-strip-item"><img src="/assets/aerial-slope.png" loading="lazy" alt="Aerial view showing slope gradient and tropical canopy" /><span class="strip-badge">Slope &amp; Terrain · Drone</span></div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       PRICING & STRUCTURE
  ═══════════════════════════════════════════════════════ -->
  <section class="section" id="pricing">
    <p class="section-label">Pricing &amp; Structure</p>
    <h2 class="section-title">Two Plots. One Rare Opportunity.<br>Flexible Purchase Options.</h2>
    <p class="body-copy pricing-lead">The land is already subdivided into two chanote plots, giving developers the option to acquire together at best value, or separately if a partner or phased approach is preferred.</p>

    <div class="pricing-grid">
      <div class="pricing-card pricing-card--featured">
        <div class="pricing-card-badge">Best Value</div>
        <p class="pricing-option-label">Option 1 - Buy Together</p>
        <p class="pricing-price">฿28,000,000</p>
        <p class="pricing-sub">฿14,000,000 per rai · Total 2 rai</p>
        <table class="pricing-table">
          <tr><td>Total Area</td><td>2 Rai</td></tr>
          <tr><td>Price per Rai</td><td>฿14,000,000</td></tr>
          <tr><td>Plots Included</td><td>Plot A + Plot B</td></tr>
          <tr><td>Saving vs Separate</td><td class="price-highlight">฿3,500,000</td></tr>
          <tr><td>Title</td><td>2 × Chanote</td></tr>
        </table>
        <a class="btn-primary btn-full" href="/request-documents">Request Documents</a>
      </div>

      <div class="pricing-card">
        <p class="pricing-option-label">Option 2 - Buy Separately</p>
        <div class="plot-row">
          <div class="plot-item">
            <p class="plot-name">Plot A</p>
            <p class="plot-price">฿8,250,000</p>
            <p class="plot-meta">0.5 rai · ฿16,500,000/rai</p>
          </div>
          <div class="plot-divider"></div>
          <div class="plot-item">
            <p class="plot-name">Plot B</p>
            <p class="plot-price">฿23,250,000</p>
            <p class="plot-meta">1.5 rai · ฿15,500,000/rai</p>
          </div>
        </div>
        <table class="pricing-table">
          <tr><td>Combined if Separate</td><td>฿31,500,000</td></tr>
          <tr><td>Title</td><td>Chanote per plot</td></tr>
          <tr><td>Road Easement</td><td>Prepared - min 2.5m</td></tr>
        </table>
        <p class="pricing-note">A road easement connecting both plots and the lower plot has already been prepared. Final road width negotiable - minimum 2.5m. Road cost shared between owners as agreed.</p>
        <a class="btn-ghost btn-full" href="/request-documents">Enquire Separately</a>
      </div>
    </div>

    <div class="legal-strip">
      <p class="legal-label">Legal Status</p>
      <p class="body-copy">Chanote title. Clean and ready to transfer. Survey documents, chanote papers, and full feasibility data available to serious buyers on request.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       WHY THIS SITE
  ═══════════════════════════════════════════════════════ -->
