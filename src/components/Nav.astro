---
interface Props {
  ctaHref?: string;
  ctaLabel?: string;
  navLinks?: Array<{ label: string; href: string }>;
}

const {
  ctaHref = '/saladsunset/request-documents',
  ctaLabel = 'Request Documents',
  navLinks = [],
} = Astro.props;
---

<nav class="nav">
  <a class="nav-logo" href="/">
    <img src="/saladsunset/assets/siamland-logo.png" alt="Siamland" class="nav-logo-img" />
  </a>
  <div class="nav-links">
    {navLinks.map(({ label, href }) => (
      <a class="nav-link" href={href}>{label}</a>
    ))}
  </div>
  <a class="nav-cta" href={ctaHref}>{ctaLabel}</a>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-nav);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    padding: 0 32px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-logo-img {
    height: 32px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex: 1;
    justify-content: center;
  }
  .nav-link {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.4px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    text-decoration: none;
    transition: color 0.15s ease;
    white-space: nowrap;
  }
  .nav-link:hover { color: var(--color-accent); }
  .nav-cta {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
    background: var(--color-accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.18s ease, transform 0.15s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav-cta:hover {
    background: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (max-width: 860px) {
    .nav-links { display: none; }
    .nav { padding: 0 20px; }
  }
</style>
